#!/usr/bin/env python3
"""ptz — pan/tilt/zoom control for the Hellocare PTZ20X2 (VISCA absolute).

usage:
  ptz                                   read current pan/tilt/zoom
  ptz P [T [Z]]                         positional: pan, tilt, zoom
  ptz pan P [tilt T] [zoom Z] [focus F] keyword form (any subset; held axes stay)
  ptz focus F | ptz focus auto          manual focus (F) or autofocus; moves nothing else
  ptz center                            quick move: pan+tilt to 0 (keeps zoom)
  ptz reset                             run the camera's own calibration -> (0,0),
                                        grind-free (~20s); use to recover a
                                        hand-moved / confused gimbal
  ptz -h

  P, T : -100..100 (percent; -=left/down, +=right/up, 0=center)
  Z    : 0..100 (0=wide/1x, 100=tele/20x) | wide | tele
  F    : 0..100 (manual focus percent) | =raw (0x0000..0x16B4) | auto
  prefix a value with '=' for a raw VISCA unit, e.g. ptz pan =0x0300 / focus =0x0e50
"""
import os, sys
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import _ptzlib as v

def _val(tok, is_zoom):
    """(units_or_pct, is_raw, err). Percent still needs mapping by caller."""
    if is_zoom and tok in ("wide", "tele"):
        return (v.WIDE if tok == "wide" else v.TELE), True, None
    if tok.startswith("="):
        r = tok[1:]
        try: return (int(r, 16) if r.lower().startswith("0x") else int(r)), True, None
        except ValueError: return None, False, "bad raw value %r" % tok
    try: return float(tok), False, None   # float percent -> fine sub-1% control
    except ValueError: return None, False, "bad value %r" % tok

def parse(argv):
    """Return (dict pan/tilt/zoom units | 'report' | 'help', err). No hardware."""
    if not argv: return "report", None
    if argv[0] in ("-h", "--help"): return "help", None
    if argv[0] == "reset":
        if len(argv) > 1: return None, "reset takes no arguments"
        return {"reset": True}, None
    out = {}
    kw = {"pan", "tilt", "zoom", "focus"}
    if any(a.lower() in kw for a in argv):
        i = 0
        while i < len(argv):
            k = argv[i].lower()
            if k not in kw: return None, "unknown token %r" % argv[i]
            if i + 1 >= len(argv): return None, "%s needs a value" % k
            tok = argv[i+1]; i += 2
            if k == "focus" and tok.lower() == "auto":
                out["focus"] = "auto"; continue
            val, raw, err = _val(tok, k == "zoom")
            if err: return None, err
            if k == "zoom": out["zoom"] = val if raw else v.zoom_u(max(0, min(100, val)))
            elif k == "pan": out["pan"] = val if raw else v.pan_u(max(-100, min(100, val)))
            elif k == "tilt": out["tilt"] = val if raw else v.tilt_u(max(-100, min(100, val)))
            else: out["focus"] = val if raw else v.focus_u(max(0, min(100, val)))
        return out, None
    if argv[0] == "center":
        if len(argv) > 1: return None, "center takes no arguments"
        out["pan"] = 0; out["tilt"] = 0; return out, None
    # positional: pan [tilt [zoom]]
    if len(argv) > 3: return None, "too many positional values (max pan tilt zoom)"
    axes = ["pan", "tilt", "zoom"]
    for idx, tok in enumerate(argv):
        val, raw, err = _val(tok, axes[idx] == "zoom")
        if err: return None, err
        if axes[idx] == "zoom": out["zoom"] = val if raw else v.zoom_u(max(0, min(100, val)))
        elif axes[idx] == "pan": out["pan"] = val if raw else v.pan_u(max(-100, min(100, val)))
        else: out["tilt"] = val if raw else v.tilt_u(max(-100, min(100, val)))
    return out, None

def report(fd):
    pt = v.get_pt(fd); z = v.get_zoom(fd); fc = v.get_focus(fd)  # all reads (no motion)
    if pt and z is not None:
        fs = ("focus=%#06x" % fc) if fc is not None else "focus=?"
        print("pan %+d%%  tilt %+d%%  zoom %d%%  %s   (raw pan=%d tilt=%d zoom=%#06x)"
              % (v.pan_pct(pt[0]), v.tilt_pct(pt[1]), v.zoom_pct(z), fs, pt[0], pt[1], z))
    else:
        print("ptz: (no read)")

def main(argv):
    action, err = parse(argv)
    if err: sys.stderr.write("ptz: %s\n" % err); return 2
    if action == "help": print(__doc__); return 0
    try: fd = v.sopen()
    except OSError as e: sys.stderr.write("ptz: cannot open %s: %s\n" % (v.DEV, e)); return 1
    try:
        if action != "report":
            if action.get("reset"):
                v.reset(fd)                     # camera's own calibration -> (0,0)
            else:
                # pan/tilt/zoom move together; held axes (not given) stay put.
                # ONLY call move() if a P/T/Z axis was given, so a focus-only
                # command never nudges pan/tilt/zoom.
                if any(action.get(a) is not None for a in ("pan", "tilt", "zoom")):
                    v.move(fd, pan=action.get("pan"), til=action.get("tilt"), zoom=action.get("zoom"))
                f = action.get("focus")
                if f == "auto": v.focus_auto(fd)
                elif f is not None: v.set_focus(fd, f)
        report(fd); return 0
    finally:
        os.close(fd)

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
